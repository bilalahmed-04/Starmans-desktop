{
  "name": "starmans-desktop",
  "version": "1.0.18",
  "description": "Starmans Sole House \u2014 Electron desktop app (main process + IPC layer wrapping Backend/ and frontend/app/)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron:dev": "concurrently -k -s first -n vite,electron -c cyan,magenta \"npm --prefix frontend/app run dev\" \"npm run electron:dev:wait\"",
    "electron:dev:wait": "wait-on -t 60000 tcp:127.0.0.1:3100 && cross-env NODE_ENV=development electron .",
    "pack": "electron-builder --dir",
    "download:sqlserver": "node scripts/downloadSqlServer.js",
    "build:frontend": "npm --prefix frontend/app run build",
    "dist:win": "npm run download:sqlserver && npm run build:frontend && electron-builder --win --publish never",
    "release:win": "npm run download:sqlserver && npm run build:frontend && electron-builder --win --publish never"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.starmans.desktop",
    "productName": "Starmans Sole House",
    "artifactName": "Starmans-Sole-House-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "scripts/**/*",
      "Backend/**/*",
      "!Backend/.env",
      "!Backend/.env.example",
      "!Backend/node_modules/.cache",
      "frontend/app/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "build/sqlserver/SQLEXPR_x64_ENU.exe",
        "to": "sqlserver/SQLEXPR_x64_ENU.exe"
      },
      {
        "from": "build/setup-sqlserver.ps1",
        "to": "setup-sqlserver.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": true,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "bilalahmed-04",
      "repo": "Starmans-desktop",
      "releaseType": "release"
    }
  }
}
