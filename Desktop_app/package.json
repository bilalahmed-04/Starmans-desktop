{
  "name": "starmans-desktop",
  "version": "1.0.0",
  "description": "Starmans Sole House — Electron desktop app (main process + IPC layer wrapping Backend/ and frontend/app/)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.starmans.desktop",
    "productName": "Starmans Sole House",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "scripts/**/*",
      "Backend/**/*",
      "!Backend/.env",
      "!Backend/.env.example",
      "!Backend/node_modules/.cache",
      "frontend/app/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
