# Template only — copy to `.env` and fill in real values there.
# `.env` is gitignored; THIS file is committed, so never put real
# credentials in it.

# MSSQL — see Backend/migrations/ for schema setup.
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=starmans
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Auth — generate a long random string for JWT_SECRET, do not ship this default.
JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=5000
