# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
Desktop_app/Backend/create-admin.js
Desktop_app/Backend/wipe-data.js

# Stray root-level files not part of the project (accidentally committed once)
/package.json
/package-lock.json
frontend_images/Screenshot from *.png

Desktop_app/frontend/app/.env

# electron-builder output (Task 16)
Desktop_app/release/

# Downloaded at build time (Task 20) — ~714MB, never committed
Desktop_app/build/sqlserver/

# Throwaway .exe output from the NSIS lint gate (Task 23) — the lint only
# cares whether it compiles, not what it produces
Desktop_app/build/nsis-lint/*.exe

# Code-signing cert (Task 25) — private key material, never committed under
# any circumstances, self-signed or not. CI gets this from GitHub Secrets.
# (Setup docs in Desktop_app/build/certs/README.md ARE committed — only
# the actual key/cert/pfx files are excluded.)
Desktop_app/build/certs/*.pfx
Desktop_app/build/certs/*.pem
Desktop_app/build/certs/*.p12

# Deployable bundle — contains the ~795MB installer, never commit the binary.
# The README/checklist inside it ARE tracked (see the ! rules below).
deployable/*
!deployable/README.md
!deployable/INSTALL-CHECKLIST.md
